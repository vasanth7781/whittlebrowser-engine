{
  "name": "@whittlebrowser/engine",
  "version": "0.1.0",
  "description": "Token-lean, ref-stable, privacy-first browser protocol for AI agents (core + Playwright/CDP driver + MCP server).",
  "license": "MIT",
  "keywords": ["mcp", "browser", "ai-agents", "cdp", "playwright", "token-efficient"],
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./page": "./dist/page/agent.js",
    "./humanpath": "./dist/core/humanpath.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "whittlebrowser-mcp": "dist/mcp/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "bench:agent": "tsx bench/agent/run.ts",
    "mcp": "tsx src/mcp/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
